* {
    background-color:            #0a0b10;
    text-color:                  #e0e6ed;
    border-color:                #00f0ff;
    font:                        "JetBrainsMono Nerd Font 12";
}

window {
    width:                       500px;
    border:                      2px;
    border-color:                #00f0ff;
    padding:                     15px;
    background-color:            #0a0b10;
}

inputbar {
    children:                    [ prompt, entry ];
    padding:                     8px;
    background-color:            #161925;
    border:                      1px;
    border-color:                #ff0055;
}

prompt {
    text-color:                  #ffe600;
    padding:                     0 8px 0 0;
}

entry {
    text-color:                  #00f0ff;
}

listview {
    lines:                       8;
    columns:                     1;
    margin:                      10px 0 0 0;
}

element {
    padding:                     8px;
    background-color:            transparent;
}

element selected {
    background-color:            #ff0055;
    text-color:                  #0a0b10;
}