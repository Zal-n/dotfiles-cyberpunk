{
  "theme": {
    "bg": "#0a0b10",
    "surface": "#121520",
    "surfaceAccent": "#1a1e2d",
    "cyan": "#00f0ff",
    "magenta": "#ff0055",
    "yellow": "#ffe600",
    "fg": "#e0e6ed",
    "fgDim": "#565f89",
    "fontFamily": "JetBrainsMono Nerd Font"
  },
  "desktop": {
    "wallpaper": "",
    "barHeight": 38,
    "cornerCutSize": 25,
    "cornerCutSizeSmall": 15,
    "toastPosition": "bottom-center",
    "powerMenu": {
      "position": "bottom-center",
      "holdTime": 1500,
      "entries": [
        { "id": "poweroff", "label": "POWER OFF", "key": "x" },
        { "id": "restart", "label": "RESTART", "key": "r" },
        { "id": "lock", "label": "LOCK", "key": "l" },
        { "id": "logout", "label": "LOGOUT", "key": "o" },
        { "id": "exit-niri", "label": "EXIT NIRI", "key": "e" }
      ]
    }
  },
  "topbar": {
    "left": [
      { "id": "logo", "preset": "sys-niri" },
      { "id": "workspaceDisplay", "preset": "dots" }
    ],
    "center": [
      { "id": "clock", "preset": "time-date" }
    ],
    "right": [
      { "id": "battery", "preset": "status-label", "device": "BAT0" },
      { "id": "separator", "preset": "space-1" },
      { "id": "wifi", "preset": "icon-signal" },
      { "id": "audio", "preset": "icon-volume", "sink": "@DEFAULT_AUDIO_SINK@" },
      { "id": "separator", "preset": "space-1" },
      { "id": "controlCenter", "preset": "default" }
    ]
  },
  "hardware": {
    "brightnessDevice": "intel_backlight",
    "audioSink": "@DEFAULT_AUDIO_SINK@"
  },
  "defaultApps": {
    "browser": ["zen-browser"],
    "terminal": ["kitty"],
    "launcher": ["quickshell", "ipc", "call", "shell", "toggleLauncher"],
    "fileManager": ["kitty", "-e", "yazi"],
    "editor": ["code"]
  }
}
