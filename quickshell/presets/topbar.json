{
  "logo": {
    "sys-niri": {
      "text": "SYS // NIRI",
      "fontSize": 13
    },
    "arch": {
      "text": "",
      "fontSize": 20
    },
    "menu": {
      "text": "☰",
      "fontSize": 20
    }
  },
  "audio": {
    "icon-volume": {
      "style": "icon",
      "fontSize": 16,
      "showPercentage": false,
      "refreshInterval": 2000,
      "mutedIcon": "󰖁",
      "unknownIcon": "󰕾",
      "lowIcon": "󰕿",
      "mediumIcon": "󰖀",
      "highIcon": "󰕾"
    },
    "bars-volume": {
      "style": "bars",
      "barCount": 5,
      "barWidth": 3,
      "barSpacing": 2,
      "barHeight": 18,
      "showPercentage": false,
      "refreshInterval": 2000
    }
  },
  "clock": {
    "time": {
      "timeFormat": "HH:mm",
      "showDate": false
    },
    "time-seconds": {
      "timeFormat": "HH:mm:ss",
      "showDate": false
    },
    "time-seconds-date": {
      "timeFormat": "HH:mm:ss",
      "showDate": true
    },
    "time-date": {
      "timeFormat": "HH:mm",
      "showDate": true
    },
    "date": {
      "timeFormat": "",
      "showDate": true
    }
  },
  "settings": {
    "default": {
      "text": "⚙"
    }
  },
  "controlCenter": {
    "default": {
      "text": "CTRL"
    }
  },
  "separator": {
    "default": {
      "text": "//"
    },
    "pipes": {
      "text": "||"
    },
    "default-reverse": {
      "text": "\\\\"
    },
    "space-1": {
      "text": " "
    },
    "space-2": {
      "text": "  "
    },
    "space-3": {
      "text": "  "
    },
    "space-4": {
      "text": "    "
    }
  },
  "workspaceDisplay": {
    "dots": {
      "style": "dots",
      "activeColor": "cyan",
      "inactiveColor": "fgDim",
      "size": 9,
      "spacing": 6
    },
    "rectangles": {
      "style": "rectangles",
      "activeColor": "cyan",
      "inactiveColor": "fgDim",
      "width": 16,
      "height": 7,
      "spacing": 5
    },
    "numbers": {
      "style": "numbers",
      "activeColor": "cyan",
      "inactiveColor": "fgDim",
      "spacing": 8,
      "fontSize": 12
    }
  },
  "battery": {
    "status-label": {
      "style": "status-label",
      "format": "PWR // {percentage}%",
      "showIcon": false,
      "showPercentage": true,
      "chargingColor": "yellow",
      "normalColor": "cyan",
      "fontSize": 13,
      "refreshInterval": 5000,
      "icons": {
        "charging": "󰂄",
        "full": "󰁹",
        "high": "󰂂",
        "medium": "󰂀",
        "low": "󰁻",
        "critical": "󰂃",
        "unknown": "󰁹"
      }
    },
    "bracketed": {
      "style": "bracketed",
      "format": "[ BAT {percentage}% ]",
      "showIcon": false,
      "showPercentage": true,
      "chargingColor": "yellow",
      "normalColor": "cyan",
      "fontSize": 13
    },
    "icon-label": {
      "style": "icon-label",
      "showIcon": true,
      "showPercentage": true,
      "chargingColor": "yellow",
      "normalColor": "cyan",
      "fontSize": 13,
      "icons": {
        "charging": "󰂄",
        "full": "󰁹",
        "high": "󰂂",
        "medium": "󰂀",
        "low": "󰁻",
        "critical": "󰂃",
        "unknown": "󰁹"
      }
    },
    "percentage": {
      "showIcon": false,
      "showPercentage": true,
      "normalColor": "cyan",
      "fontSize": 13
    }
  },
  "wifi": {
    "icon-signal": {
      "showSignal": true,
      "fontSize": 16,
      "connectedColor": "cyan",
      "disconnectedColor": "magenta",
      "icons": {
        "connected": "󰤨",
        "disconnected": "󰤭"
      }
    }
  }
}
