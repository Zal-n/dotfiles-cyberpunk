output "eDP-1" {
    mode "2560x1600@165.000"
    scale 1.5
}

input {
  keyboard{
    xkb {
      layout "hu"
    }
  }
  touchpad {
    tap
    natural-scroll
  }
}

hotkey-overlay {
  skip-at-startup
}

layout {
    gaps 12
    center-focused-column "never"
    background-color "transparent" 

    focus-ring {
        width 4
        active-color "#0c0e12"
        inactive-color "#0c0e12"
    }
    border {
        

        width 2
        active-color "#00f0ff"
        inactive-color "#121520"

        urgent-color "#9b0000"
    }
    shadow {
      softness 30
      spread 5
      offset x=0 y=5
      color "#0007"
    }
}
prefer-no-csd

include "binds.kdl"

// Start Quickshell DE
spawn-at-startup "sh" "-c" "QS_NO_RELOAD_POPUP=1 quickshell"

gestures {
  hot-corners {
    off 
  }
}
